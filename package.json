{
  "name": "bigsignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1",
    "build": "bun run typecheck && vite build apps/web",
    "test": "vitest run",
    "test:physics": "vitest run packages/units packages/simulation packages/propagation validation",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/worker/tsconfig.json",
    "dev:server": "bun --watch apps/server/index.ts",
    "start": "bun apps/server/index.ts",
    "dev:worker": "wrangler dev --ip 127.0.0.1",
    "types:worker": "wrangler types apps/worker/worker-configuration.d.ts --strict-vars=false",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:worker": "wrangler deploy",
    "test:worker-runtime": "bun scripts/check-worker-runtime.ts"
  },
  "dependencies": {
    "@bigsignal/contracts": "workspace:*",
    "@bigsignal/simulation": "workspace:*",
    "@openai/agents": "^0.18.0",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "0.186.0",
    "zod": "^4.6.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
